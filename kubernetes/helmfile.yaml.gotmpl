environments:
  production:
    # RECREATE markers specify commands to retrieve new values when recreating cluster resources.
    values:
      - cluster:
          name: eks
          # RECREATE: cd aws/eks/production && TG_TF_PATH=tofu terragrunt output -raw cluster_endpoint_hostname
          eksApiEndpoint: 1A030C76F9D24F7E4A50FEFAB02BCC5B.gr7.ap-northeast-1.eks.amazonaws.com
          # RECREATE: cd aws/vpc/production && TG_TF_PATH=tofu terragrunt output -raw vpc_id
          vpcId: vpc-0407902fa994e8750
          # STABLE: deterministic role name configured without prefix or timestamp suffix in aws/eks/modules/addons.tf.
          albControllerRoleArn: arn:aws:iam::337169763788:role/eks-alb-controller
          # STABLE: deterministic role name configured without prefix or timestamp suffix in aws/eks/modules/addons.tf.
          externalDnsRoleArn: arn:aws:iam::337169763788:role/eks-external-dns
        karpenter:
          # STABLE: deterministic node role name configured in aws/eks-karpenter/modules/main.tf.
          nodeRoleName: Karpenter-eks
          # STABLE: interruption queue name derived deterministically from cluster_name.
          interruptionQueueName: Karpenter-eks
        mimir:
          # Parent values are not auto-inherited by child helmfiles, requiring explicit redefinition in component helmfile.
          bucketName: mimir-337169763788
          # Kept for operator verification; pod identity association is provisioned by aws/eks-metrics.
          podIdentityRoleName: eks-mimir
        loki:
          bucketName: loki-337169763788
          podIdentityRoleName: eks-loki
        tempo:
          bucketName: tempo-337169763788
          podIdentityRoleName: eks-tempo

helmfiles:
  - components/*/{{ .Environment.Name }}/helmfile.yaml
