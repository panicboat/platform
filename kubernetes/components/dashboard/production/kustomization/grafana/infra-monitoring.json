      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "Not Ready"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
