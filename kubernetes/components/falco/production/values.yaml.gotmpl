# Uses modern_ebpf to avoid init containers and kernel module build dependencies.
driver:
  kind: modern_ebpf
  modernEbpf:
    # Restricts capabilities to required subset instead of running privileged.
    leastPrivileged: true

# Follow container disabled and install refs pinned to avoid untracked out-of-band rule changes.
falcoctl:
  artifact:
    install:
      enabled: true
    follow:
      enabled: false
  config:
    artifact:
      install:
        refs:
          # renovate: datasource=docker depName=ghcr.io/falcosecurity/rules/falco-rules
          - falco-rules:5.2.0
      follow:
        refs:
          - falco-rules:5.1.0

falco:
  # Outputs JSON to stdout for OTel Collector and Loki parsing.
  json_output: true
  # Disables syslog output as container has no syslog daemon.
  syslog_output:
    enabled: false

# Tolerates all taints including system-critical to monitor every node.
tolerations:
  - effect: NoSchedule
    operator: Exists
  - effect: NoExecute
    operator: Exists

podPriorityClassName: system-node-critical

metrics:
  enabled: true
serviceMonitor:
  create: true
  labels:
    release: kube-prometheus-stack

# Requests right-sized from actual usage while retaining chart default limits.
resources:
  requests:
    cpu: 50m
    memory: 128Mi

# Appends Beyla to known packet socket binaries to silence false positive alerts.
customRules:
  beyla-packet-socket.yaml: |-
    - list: user_known_packet_socket_binaries
      items: [beyla]
      override:
        items: append
