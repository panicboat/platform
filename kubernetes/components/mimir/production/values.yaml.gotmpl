serviceAccount:
  create: true
  name: mimir

mimir:
  structuredConfig:
    common:
      storage:
        backend: s3
        s3:
          bucket_name: {{ .Values.mimir.bucketName }}
          endpoint: s3.ap-northeast-1.amazonaws.com
          region: ap-northeast-1
    blocks_storage:
      storage_prefix: "{{ .Values.mimir.bucketPathPrefix }}"
      backend: s3
      s3:
        bucket_name: {{ .Values.mimir.bucketName }}
        endpoint: s3.ap-northeast-1.amazonaws.com
        region: ap-northeast-1
    multitenancy_enabled: false
    ingest_storage:
      enabled: false
    ingester:
      push_grpc_method_enabled: true
      ring:
        # Replication factor 1 is required for single ingester replica deployment.
        replication_factor: 1
    store_gateway:
      sharding_ring:
        # Replication factor 1 is required for single store-gateway replica deployment.
        replication_factor: 1
    limits:
      # Raised from chart default 150000 to prevent series limit exhaustion.
      max_global_series_per_user: 500000

minio:
  enabled: false
kafka:
  enabled: false

alertmanager:
  enabled: false
ruler:
  enabled: false
overrides_exporter:
  enabled: false

gateway:
  enabled: true
  replicas: 1
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 256Mi

distributor:
  replicas: 1
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi

ingester:
  replicas: 1
  # Zone-aware replication is disabled for single-replica deployment.
  zoneAwareReplication:
    enabled: false
  resources:
    requests:
      cpu: 75m
      memory: 768Mi
    limits:
      cpu: 1
      memory: 2Gi
  persistentVolume:
    enabled: true
    storageClass: gp3
    size: 10Gi

querier:
  replicas: 1
  resources:
    requests:
      cpu: 25m
      memory: 96Mi
    limits:
      cpu: 500m
      memory: 1Gi

query_frontend:
  replicas: 1
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      cpu: 500m
      memory: 512Mi

store_gateway:
  replicas: 1
  # Zone-aware replication is disabled for single-replica deployment.
  zoneAwareReplication:
    enabled: false
  resources:
    requests:
      cpu: 25m
      memory: 96Mi
    limits:
      cpu: 500m
      memory: 2Gi
  persistentVolume:
    enabled: true
    storageClass: gp3
    size: 20Gi

compactor:
  replicas: 1
  resources:
    requests:
      cpu: 25m
      memory: 96Mi
    limits:
      cpu: 500m
      memory: 2Gi
  persistentVolume:
    enabled: true
    storageClass: gp3
    size: 10Gi

chunks-cache:
  enabled: true
  replicas: 1
  allocatedMemory: 512
  resources:
    requests:
      cpu: 25m
      memory: 512Mi
    limits:
      cpu: 200m
      memory: 1Gi

query_scheduler:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi

rollout_operator:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
