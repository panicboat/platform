grafana:
  enabled: true
  # Test framework disabled to avoid dangling pods in CI.
  testFramework:
    enabled: false

  # Admin credentials sourced from AWS Secrets Manager via ExternalSecret.
  admin:
    existingSecret: grafana-admin
    userKey: admin-user
    passwordKey: admin-password

  # Reloader restarts Grafana when admin credentials Secret changes.
  annotations:
    reloader.stakater.com/auto: "true"

  # Configures oauth2-proxy header authentication alongside fallback admin login.
  grafana.ini:
    auth.proxy:
      enabled: true
      header_name: X-Forwarded-User
      header_property: username
      auto_sign_up: true
      sync_ttl: 60
    users:
      auto_assign_org: true
      auto_assign_org_role: Admin

  resources:
    requests:
      cpu: 25m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 1Gi

  persistence:
    enabled: true
    size: 5Gi
    storageClassName: gp3

  # Recreate strategy prevents multi-attach errors on ReadWriteOnce EBS volumes during pod rolling updates.
  deploymentStrategy:
    type: Recreate

  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL
    datasources:
      # Disabled so Mimir is declared as the single primary datasource below.
      defaultDatasourceEnabled: false

  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Mimir
          uid: mimir
          type: prometheus
          url: http://mimir-distributed-gateway.monitoring.svc.cluster.local/prometheus
          access: proxy
          isDefault: true
          jsonData:
            httpMethod: POST
            timeInterval: 30s
            # manageAlerts disabled because Mimir ruler is not enabled.
            manageAlerts: false
        - name: Prometheus (local)
          uid: prometheus-local
          type: prometheus
          url: http://prometheus-operated.monitoring.svc.cluster.local:9090
          access: proxy
          isDefault: false
          jsonData:
            httpMethod: POST
            timeInterval: 30s
        - name: Loki
          uid: loki
          type: loki
          url: http://loki-gateway.monitoring.svc.cluster.local
          access: proxy
          isDefault: false
          jsonData:
            httpHeaderName1: X-Scope-OrgID
          secureJsonData:
            httpHeaderValue1: anonymous
        - name: Tempo
          uid: tempo
          type: tempo
          url: http://tempo.monitoring.svc.cluster.local:3200
          access: proxy
          isDefault: false
          jsonData:
            httpMethod: GET
            tracesToLogsV2:
              datasourceUid: loki
            tracesToMetrics:
              datasourceUid: mimir
            # Queries Tempo service graph metrics remote-written to Mimir.
            serviceMap:
              datasourceUid: mimir

prometheus:
  prometheusSpec:
    # Enforces legacy validation so dotted UTF-8 metric labels from OTel Collector are accepted downstream by Mimir.
    nameValidationScheme: Legacy

    serviceMonitorSelectorNilUsesHelmValues: false
    serviceMonitorSelector: {}
    serviceMonitorNamespaceSelector: {}
    podMonitorSelectorNilUsesHelmValues: false
    podMonitorSelector: {}
    podMonitorNamespaceSelector: {}

    retention: 24h

    remoteWrite:
      - url: http://mimir-distributed-gateway.monitoring.svc.cluster.local/api/v1/push
        headers:
          X-Scope-OrgID: anonymous
        # Drops high-cardinality apiserver buckets before remote write to stay within Mimir limits.
        writeRelabelConfigs:
          - sourceLabels: [__name__]
            regex: "apiserver_(request|response|watch_list|watch_cache_read_wait|storage_list|watch_events|request_body_size|request_sli|request_slo)_.+_bucket"
            action: drop
          - sourceLabels: [__name__]
            regex: "etcd_request_duration_seconds_bucket"
            action: drop

    resources:
      requests:
        cpu: 150m
        memory: 1536Mi
      limits:
        cpu: 1
        memory: 2Gi

    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3
          resources:
            requests:
              storage: 20Gi

alertmanager:
  enabled: true
  alertmanagerSpec:
    resources:
      requests:
        cpu: 25m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3
          resources:
            requests:
              storage: 2Gi
    # Alertmanager namespace requires its own Secret instance for the shared token.
    secrets:
      - holmes-alertmanager
      - alertmanager-slack-notify
  config:
    global:
      resolve_timeout: 5m
    inhibit_rules:
      - source_matchers:
          - 'severity = critical'
        target_matchers:
          - 'severity =~ warning|info'
        equal:
          - 'namespace'
          - 'alertname'
      - source_matchers:
          - 'severity = warning'
        target_matchers:
          - 'severity = info'
        equal:
          - 'namespace'
          - 'alertname'
      - source_matchers:
          - 'alertname = InfoInhibitor'
        target_matchers:
          - 'severity = info'
        equal:
          - 'namespace'
          - 'alertname'
      - target_matchers:
          - 'alertname = InfoInhibitor'
    route:
      group_by: ['namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
      receiver: 'null'
      routes:
        # Watchdog null route must precede critical alert routes in Alertmanager first-match routing.
        - receiver: 'null'
          matchers:
            - alertname = "Watchdog"
        - receiver: 'critical-alerts'
          matchers:
            - severity = "critical"
          continue: true
    receivers:
      - name: 'null'
      - name: 'critical-alerts'
        slack_configs:
          - api_url_file: /etc/alertmanager/secrets/alertmanager-slack-notify/SLACK_WEBHOOK_URL
            send_resolved: false
            title: 'Critical alert(s) firing'
            text: |-
              {{ "{{" }} range .Alerts }}*{{ "{{" }} .Labels.alertname }}* ({{ "{{" }} .Labels.namespace }})
              {{ "{{" }} .Annotations.summary }}
              fingerprint: `{{ "{{" }} .Fingerprint }}`
              {{ "{{" }} end }}
        webhook_configs:
          # Slack channel must be a conversation ID because conversations.history API rejects names.
          - url: 'https://holmes.panicboat.net/alertmanager/webhook?channel=C0BQE7KHUCE'
            send_resolved: false
            http_config:
              authorization:
                credentials_file: /etc/alertmanager/secrets/holmes-alertmanager/ALERTMANAGER_SHARED_TOKEN
    templates:
      - '/etc/alertmanager/config/*.tmpl'

prometheus-node-exporter:
  # Priority class ensures DaemonSet pod scheduling integrity on every node.
  priorityClassName: system-node-critical
  hostRootFsMount:
    enabled: true
    mountPropagation: HostToContainer
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

kube-state-metrics:
  metricLabelsAllowlist:
    - pods=[*]
    - deployments=[*]
    - statefulsets=[*]
  resources:
    requests:
      cpu: 25m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi

# EKS managed control plane components and Cilium-replaced kube-proxy are unreachable for scraping.
kubeScheduler:
  enabled: false
kubeControllerManager:
  enabled: false
kubeProxy:
  enabled: false

prometheusOperator:
  admissionWebhooks:
    enabled: true
    patch:
      enabled: true
  tls:
    enabled: true
  resources:
    requests:
      cpu: 25m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi
