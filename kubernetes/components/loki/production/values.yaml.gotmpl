deploymentMode: Monolithic

loki:
  auth_enabled: false

  commonConfig:
    path_prefix: /var/loki
    # Replication factor 1 for single-replica deployment.
    replication_factor: 1

  storage:
    type: s3
    bucketNames:
      chunks: {{ .Values.loki.bucketName }}
      ruler: {{ .Values.loki.bucketName }}
    s3:
      region: ap-northeast-1
      s3ForcePathStyle: false
      endpoint: null
      accessKeyId: null
      secretAccessKey: null

  schemaConfig:
    configs:
      - from: "2024-01-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: loki_index_
          period: 24h

  storage_config:
    aws:
      region: ap-northeast-1
      bucketnames: {{ .Values.loki.bucketName }}
      s3forcepathstyle: false
    tsdb_shipper:
      active_index_directory: /var/loki/tsdb-index
      cache_location: /var/loki/tsdb-cache

  limits_config:
    retention_period: 720h
    reject_old_samples: true
    reject_old_samples_max_age: 168h
    ingestion_rate_mb: 10
    ingestion_burst_size_mb: 20
    max_line_size: 256KB
    max_entries_limit_per_query: 5000

  compactor:
    working_directory: /var/loki/compactor
    # Retention enforcement is disabled because S3 bucket lifecycle manages 30-day retention.
    retention_enabled: false
    delete_request_store: s3

  ingester:
    # Reduced flush interval limits data loss window during unexpected termination.
    chunk_idle_period: 2m
    max_chunk_age: 1h
    chunk_target_size: 1536000

serviceAccount:
  create: true
  name: loki
  annotations: {}

singleBinary:
  enabled: true
  replicas: 1

  persistence:
    enabled: true
    storageClass: gp3
    size: 10Gi

  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 1
      memory: 2Gi

  # PodDisruptionBudget disabled to prevent blocking node drains with single-replica pod.
  podDisruptionBudget:
    enabled: false

gateway:
  enabled: true
  replicas: 1
  resources:
    requests:
      cpu: 15m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 256Mi

read:
  replicas: 0
write:
  replicas: 0
backend:
  replicas: 0

chunksCache:
  enabled: false
resultsCache:
  enabled: false

test:
  enabled: false

lokiCanary:
  enabled: false

tableManager:
  enabled: false

networkPolicy:
  enabled: false

monitoring:
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack
    interval: 15s

  rules:
    enabled: false

  dashboards:
    enabled: false
