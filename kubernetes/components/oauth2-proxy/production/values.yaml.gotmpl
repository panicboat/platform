{{- $upstreamMap := dict
  "oauth2-proxy-grafana" "http://kube-prometheus-stack-grafana.monitoring.svc.cluster.local:80"
  "oauth2-proxy-hubble" "http://hubble-ui.kube-system.svc.cluster.local:80"
  "oauth2-proxy-alertmanager" "http://kube-prometheus-stack-alertmanager.monitoring.svc.cluster.local:9093"
  "oauth2-proxy-prometheus" "http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090"
}}
{{- $upstreamUrl := index $upstreamMap .Release.Name }}

# Unifies resource names with release name for simpler Ingress backend referencing.
fullnameOverride: {{ .Release.Name }}

replicaCount: 2

priorityClassName: system-cluster-critical

resources:
  requests:
    cpu: 15m
    memory: 64Mi
  limits:
    cpu: 200m
    memory: 256Mi

config:
  existingSecret: oauth2-proxy-google
  configFile: |-
    provider = "google"
    email_domains = [ "panicboat.net" ]
    upstreams = [ "{{ $upstreamUrl }}" ]
    cookie_domains = [ ".panicboat.net" ]
    whitelist_domains = [ ".panicboat.net" ]
    cookie_secure = true
    cookie_httponly = true
    cookie_samesite = "lax"
    pass_authorization_header = true
    pass_access_token = true
    set_authorization_header = true
    set_xauthrequest = true
    skip_provider_button = true
    reverse_proxy = true
    # prefer_email_to_user sets email in X-Forwarded-User for human-readable usernames in Grafana auth.proxy.
    prefer_email_to_user = true

# Automatically rolls out pods when ESO-synced OAuth secret is rotated.
deploymentAnnotations:
  reloader.stakater.com/auto: "true"

service:
  type: ClusterIP
  portNumber: 80

metrics:
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack
