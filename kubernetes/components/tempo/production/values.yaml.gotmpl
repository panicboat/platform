tempo:
  multitenancyEnabled: false

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 1
      memory: 2Gi

  storage:
    trace:
      backend: s3
      s3:
        bucket: {{ .Values.tempo.bucketName }}
        endpoint: s3.ap-northeast-1.amazonaws.com
        region: ap-northeast-1
        prefix: {{ .Values.tempo.bucketPathPrefix }}

  # Jaeger protocol keys cannot be set to null due to nil pointer errors in chart port template.
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

  # Enables service_graphs processor while omitting span_metrics to avoid duplicate RED cardinality with Beyla.
  metricsGenerator:
    enabled: true
    registry:
      external_labels:
        cluster: eks-production
    processor:
      service_graphs:
        wait: 10s
        max_items: 10000
    storage:
      path: /tmp/tempo
      remote_write:
        - url: http://mimir-distributed-gateway.monitoring.svc.cluster.local/api/v1/push
          headers:
            X-Scope-OrgID: anonymous

  # Processors must be explicitly enumerated under defaults even with multitenancy disabled.
  overrides:
    defaults:
      metrics_generator:
        processors:
          - service-graphs

serviceAccount:
  create: true
  name: tempo
  annotations: {}

persistence:
  enabled: true
  storageClassName: gp3
  size: 10Gi
  accessModes:
    - ReadWriteOnce

# PodDisruptionBudget disabled to prevent blocking node drains with single-replica pod.
podDisruptionBudget:
  enabled: false

service:
  type: ClusterIP

serviceMonitor:
  enabled: true
  additionalLabels:
    release: kube-prometheus-stack
  interval: 15s
