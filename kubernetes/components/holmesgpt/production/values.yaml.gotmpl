# Fixed name required by Pod Identity Association mapping.
createServiceAccount: true
customServiceAccountName: holmesgpt

# k8sRBAC false retains the chart read-only ClusterRole.
k8sRBAC: false

# Keep bedrock models in sync with aws/eks-holmesgpt/modules/main.tf.
additionalEnvVars:
  - name: AWS_REGION_NAME
    value: us-east-1

modelList:
  sonnet-4-6:
    model: bedrock/us.anthropic.claude-sonnet-4-6
    temperature: 0

toolsets:
  kubernetes/core:
    enabled: true
  kubernetes/logs:
    enabled: true

  # Points to Mimir Prometheus-compatible endpoint without additional headers.
  prometheus/metrics:
    enabled: true
    config:
      prometheus_url: http://mimir-distributed-gateway.monitoring.svc.cluster.local/prometheus

  internet:
    enabled: true

  # Robusta SaaS integration disabled to avoid unneeded external traffic.
  robusta:
    enabled: false

  # Narrowed to core with read-only git/cat/find commands allowed for investigation.
  bash:
    enabled: true
    config:
      builtin_allowlist: "core"
      allow:
        - "git clone"
        - "git log"
        - "git show"
        - "git diff"
        - "git blame"
        - "git ls-files"
        - "git grep"
        - "cat"
        - "find"

# Enables only CRDs actively deployed in this cluster.
crdPermissions:
  flux: true
  gatewayApi: true
  keda: true
  externalSecrets: true

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 10001
  runAsGroup: 10001
  fsGroup: 10001
  seccompProfile:
    type: RuntimeDefault

containerSecurityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL

resources:
  requests:
    cpu: 50m
    memory: 512Mi
  limits:
    memory: 2Gi
