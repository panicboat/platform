# Preserves stable service name expected by Beyla OTLP endpoint configuration.
fullnameOverride: opentelemetry-collector

mode: daemonset

image:
  repository: otel/opentelemetry-collector-contrib
  tag: 0.151.0

resources:
  requests:
    cpu: 40m
    memory: 256Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Tolerates all taints to collect logs and traces across every node.
tolerations:
  - effect: NoSchedule
    operator: Exists
  - effect: NoExecute
    operator: Exists

priorityClassName: system-node-critical

# Enables ClusterIP service required for Beyla OTLP communication in daemonset mode.
service:
  enabled: true

ports:
  # Metrics port is required for ServiceMonitor scraping.
  metrics:
    enabled: true
  jaeger-compact:
    enabled: false
  jaeger-grpc:
    enabled: false
  jaeger-thrift:
    enabled: false
  zipkin:
    enabled: false

serviceMonitor:
  enabled: true
  extraLabels:
    release: kube-prometheus-stack
  metricsEndpoints:
    - port: metrics

presets:
  logsCollection:
    enabled: true
    includeCollectorLogs: false
    storeCheckpoints: true
  kubernetesAttributes:
    enabled: true

config:
  receivers:
    filelog:
      # start_at end prevents backfilling historical log data into Loki on initial deployment.
      start_at: end
    # Disables unused legacy tracing receivers.
    jaeger: null
    zipkin: null

  processors:
    resource:
      attributes:
        - key: cluster.name
          value: eks-production
          action: upsert
    transform/workload:
      error_mode: ignore
      trace_statements: &workload_resource_statements
        - context: resource
          statements:
            - set(attributes["workload"], attributes["k8s.deployment.name"]) where attributes["k8s.deployment.name"] != nil
            - set(attributes["workload"], attributes["k8s.statefulset.name"]) where attributes["k8s.statefulset.name"] != nil
            - set(attributes["workload"], attributes["k8s.daemonset.name"]) where attributes["k8s.daemonset.name"] != nil
            - set(attributes["workload"], attributes["k8s.job.name"]) where attributes["k8s.job.name"] != nil
            - set(attributes["workload"], attributes["k8s.cronjob.name"]) where attributes["k8s.cronjob.name"] != nil
      log_statements: *workload_resource_statements

  exporters:
    otlp_grpc/tempo:
      endpoint: tempo.monitoring.svc.cluster.local:4317
      tls:
        insecure: true
    otlp_http/loki:
      endpoint: http://loki-gateway.monitoring.svc.cluster.local:80/otlp
      tls:
        insecure: true

  service:
    pipelines:
      traces:
        receivers: [otlp]
        processors: [memory_limiter, k8sattributes, resource, transform/workload, batch]
        exporters: [otlp_grpc/tempo]
      logs:
        receivers: [filelog]
        processors: [memory_limiter, k8sattributes, resource, transform/workload, batch]
        exporters: [otlp_http/loki]
      # Removes unused metrics pipeline as Beyla exposes metrics directly.
      metrics: null
