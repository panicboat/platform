preset: application

config:
  data:
    otel_traces_export:
      endpoint: http://opentelemetry-collector.monitoring.svc.cluster.local:4317
      protocol: grpc
      interval: 5s
      max_export_batch_size: 512

    # Metrics are scraped via ServiceMonitor rather than exported via OTLP.
    prometheus_export:
      port: 9090
      path: /metrics

    discovery:
      instrument:
        - k8s_namespace: default
        - k8s_namespace: dystopia
        - k8s_namespace: system-components
      # Monolith is excluded as Ruby gruf gRPC is instrumented via OTel SDK directly.
      exclude_instrument:
        - k8s_deployment_name: monolith

    routes:
      unmatched: heuristic

    # Drops redundant Kubernetes metadata labels across all metric patterns to stay within Mimir label limits.
    attributes:
      kubernetes:
        enable: true
      select:
        '*':
          exclude:
            - k8s_container_name
            - k8s_kind
            - k8s_owner_name
            - k8s_pod_start_time
            - k8s_pod_uid
            - k8s_replicaset_name

    filter:
      network:
        k8s_dst_owner_name:
          not_match: "{kube*,*prometheus*,*grafana*,*mimir*,*loki*,*tempo*}"
        k8s_src_owner_name:
          not_match: "{kube*,*prometheus*,*grafana*,*mimir*,*loki*,*tempo*}"

resources:
  requests:
    cpu: 15m
    memory: 48Mi
  limits:
    cpu: 200m
    memory: 384Mi

priorityClassName: system-cluster-critical

# Service must be enabled to provide a scrape target for ServiceMonitor.
service:
  enabled: true

serviceMonitor:
  enabled: true
  additionalLabels:
    release: kube-prometheus-stack
