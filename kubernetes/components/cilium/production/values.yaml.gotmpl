ipam:
  mode: eni

eni:
  enabled: true

routingMode: native
endpointRoutes:
  enabled: true
# Masquerade is disabled so pod-to-pod traffic retains direct VPC secondary IP routing.
enableIPv4Masquerade: false
ipv6:
  enabled: false

kubeProxyReplacement: true
k8sServiceHost: {{ .Values.cluster.eksApiEndpoint }}
k8sServicePort: 443

# Tolerates all taints so the CNI plugin is placed on every node including system-critical.
tolerations:
  - operator: Exists

# Operator is pinned to system-critical MNG to prevent Karpenter drift and lost EC2 ENI loops.
operator:
  replicas: 2
  rollOutPods: true
  nodeSelector:
    node-role/system-critical: "true"
  tolerations:
    - key: dedicated
      operator: Equal
      value: system-critical
      effect: NoSchedule
  prometheus:
    enabled: true
    serviceMonitor:
      enabled: true
      # Prevents offline helmfile template failures before CRDs are registered.
      trustCRDsExist: true
      labels:
        release: kube-prometheus-stack

envoy:
  enabled: true

# Host network mode runs Envoy on node ports without creating LoadBalancer services.
gatewayAPI:
  enabled: true
  hostNetwork:
    enabled: true

# Enables ClusterIP routing for hostNetwork pods.
socketLB:
  enabled: true

hubble:
  enabled: true
  # CA-based issuer is required for mTLS across hubble components instead of SelfSigned.
  tls:
    auto:
      method: certmanager
      certManagerIssuerRef:
        name: cilium-hubble-ca-issuer
        kind: ClusterIssuer
        group: cert-manager.io
  relay:
    enabled: true
    # Nullifies chart requiredDuringScheduling to prevent Karpenter capacity churn during spot churn.
    affinity:
      podAffinity:
        requiredDuringSchedulingIgnoredDuringExecution: null
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  k8s-app: cilium
              topologyKey: kubernetes.io/hostname
  ui:
    enabled: true
  metrics:
    enabled:
      - dns
      - drop
      - tcp
      - flow
      - icmp
      - http
    serviceMonitor:
      enabled: true
      # Prevents offline helmfile template failures before CRDs are registered.
      trustCRDsExist: true
      labels:
        release: kube-prometheus-stack

# Required for DNS resolution in hostNetwork pods.
dnsProxy:
  enabled: true

prometheus:
  enabled: true
  serviceMonitor:
    enabled: true
    # Prevents offline helmfile template failures before CRDs are registered.
    trustCRDsExist: true
    labels:
      release: kube-prometheus-stack
