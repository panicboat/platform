fullnameOverride: keycloak

replicas: 1

# Explicit start argument is required because the chart default leaves entrypoint arguments empty.
args:
  - start

# Overrides legacy /auth path default to current root path standard.
http:
  relativePath: "/"

# ALB sends X-Forwarded headers requiring xforwarded mode rather than RFC7239 forwarded.
proxy:
  mode: xforwarded

database:
  vendor: postgres
  hostname: keycloak-db-rw.keycloak.svc.cluster.local
  port: "5432"
  database: keycloak
  username: keycloak
  existingSecret: keycloak-db-app
  existingSecretKey: password

extraEnv: |
  - name: KC_HOSTNAME
    value: auth.dystopia.city
  - name: KC_BOOTSTRAP_ADMIN_USERNAME
    valueFrom:
      secretKeyRef:
        name: keycloak-admin
        key: username
  - name: KC_BOOTSTRAP_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-admin
        key: password

resources:
  requests:
    cpu: 500m
    memory: 1Gi
  limits:
    cpu: "1500m"
    memory: 1536Mi
