{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>panicboat/.github"
  ],
  "packageRules": [
    {
      "description": "Track OpenTofu releases instead of Terraform for required_version",
      "matchDepTypes": [
        "required_version"
      ],
      "matchDepNames": [
        "hashicorp/terraform"
      ],
      "overridePackageName": "opentofu/opentofu"
    },
    {
      "description": "Boundary lookup modules - keep ranges permissive, never narrow lower bound",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "**/lookup/terraform.tf"
      ],
      "rangeStrategy": "widen"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "EKS Kubernetes version pinned in env.hcl",
      "managerFilePatterns": [
        "/^aws/eks/.+/env\\.hcl$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*cluster_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Falco ruleset OCI artifact pinned in values (helmfile manager does not see OCI refs)",
      "managerFilePatterns": [
        "/^kubernetes/components/falco/.+/values\\.yaml\\.gotmpl$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*-\\s*falco-rules:(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Karpenter OCI chart pinned in helmfile (helmfile manager does not see oci:// chart refs)",
      "managerFilePatterns": [
        "/^kubernetes/components/karpenter/.+/helmfile\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
